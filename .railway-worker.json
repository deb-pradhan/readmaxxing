{
  "$schema": "https://docs.railway.app/reference/config-as-code",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/worker-python/Dockerfile",
    "buildContext": "services/worker-python"
  },
  "deploy": {
    "name": "worker-python",
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1,
    "variables": {
      "NODE_ENV": "production",
      "PORT": "8000",
      "PYTHONUNBUFFERED": "1",
      "PODCAST_VOLUME_PATH": "/data/podcasts"
    },
    "volumes": [
      {
        "name": "podcast-volume",
        "mountPath": "/data/podcasts"
      }
    ]
  }
}