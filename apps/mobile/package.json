{
  "name": "@readmaxxing/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "ReadMaxxing Expo / React Native mobile app.",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "doctor": "expo-doctor",
    "typecheck": "echo 'mobile typecheck runs after `pnpm install` (expo + react-native deps). See README.md.'",
    "test": "echo 'mobile test runs after `pnpm install` (expo + react-native deps). See README.md.'",
    "lint": "echo 'lint: mobile'",
    "clean": "rm -rf .expo dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@readmaxxing/core": "workspace:*",
    "@readmaxxing/ui": "workspace:*",
    "expo": "~52.0.0",
    "expo-av": "~15.0.0",
    "expo-camera": "~16.0.0",
    "expo-constants": "~17.0.0",
    "expo-document-picker": "~12.0.0",
    "expo-linking": "~7.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.76.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.0",
    "@types/react-native": "~0.73.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "private": true
}
