{
  "name": "@readmaxxing/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ReadMaxxing Chrome MV3 extension — overlay reader on any page.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "lint": "echo 'lint: extension'",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@mozilla/readability": "^0.5.0",
    "@readmaxxing/core": "workspace:*",
    "@readmaxxing/tts": "workspace:*",
    "@readmaxxing/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.0"
  }
}
